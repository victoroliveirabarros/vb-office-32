# Copy to .env for local development; `make run` loads it.
# Plain KEY=value lines: make reads this file, so no quotes and no '$'.
VB_OFFICE32_ADDR=:8080
VB_OFFICE32_MAPS_DIR=maps
VB_OFFICE32_WEB_DIR=web/dist
VB_OFFICE32_ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173
VB_OFFICE32_MAX_SESSIONS=200
VB_OFFICE32_LOG_LEVEL=debug

# Guest mode trusts any name typed in the browser: development only.
# The server's default is oidc.
VB_OFFICE32_AUTH=guest

# To try OIDC locally, register http://localhost:5173/auth/callback as a
# redirect URI at your provider, comment out AUTH=guest above and fill in:
# VB_OFFICE32_AUTH=oidc
# VB_OFFICE32_PUBLIC_URL=http://localhost:5173
# VB_OFFICE32_OIDC_ISSUER=https://accounts.google.com
# VB_OFFICE32_OIDC_CLIENT_ID=
# VB_OFFICE32_OIDC_CLIENT_SECRET=
# VB_OFFICE32_ALLOWED_DOMAINS=example.com
# VB_OFFICE32_SESSION_KEY=
