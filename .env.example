# Copy to .env for local development; `make run` loads it.
# Plain KEY=value lines: make reads this file, so no quotes and no '$'.
VB_OFFICE32_ADDR=:8080
VB_OFFICE32_MAPS_DIR=maps
VB_OFFICE32_WEB_DIR=web/dist
VB_OFFICE32_ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173
VB_OFFICE32_MAX_SESSIONS=200
VB_OFFICE32_LOG_LEVEL=debug
