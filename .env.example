# Copy to .env for local development; make loads it.
# Plain KEY=value lines: make reads this file, so no quotes and no '$'.
VB_OFFICE32_ADDR=:8080
VB_OFFICE32_MAPS_DIR=maps
VB_OFFICE32_WEB_DIR=web/dist
VB_OFFICE32_ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173
VB_OFFICE32_MAX_SESSIONS=200
VB_OFFICE32_LOG_LEVEL=debug

# OIDC against the development provider (make devidp, or make dev-oidc for
# devidp + server + Vite). Same login path as production, no Google needed.
# Open http://localhost:5173 (not 127.0.0.1): the cookies belong to that host.
VB_OFFICE32_AUTH=oidc
VB_OFFICE32_PUBLIC_URL=http://localhost:5173
VB_OFFICE32_OIDC_ISSUER=http://localhost:9000
VB_OFFICE32_OIDC_CLIENT_ID=dev-client
VB_OFFICE32_OIDC_CLIENT_SECRET=dev-secret
VB_OFFICE32_ALLOWED_DOMAINS=example.com
# Fill with the output of: openssl rand -base64 32
VB_OFFICE32_SESSION_KEY=

# Proximity audio and video through LiveKit in development mode (make
# livekit, or make dev-oidc which starts it when the URL below is local). The
# browser connects to it directly. Comment the three lines out to turn media
# off; set all three or none.
VB_OFFICE32_LIVEKIT_URL=ws://localhost:7880
VB_OFFICE32_LIVEKIT_API_KEY=devkey
VB_OFFICE32_LIVEKIT_API_SECRET=secret

# Guest mode instead: anyone joins under any name typed in the browser.
# Uncomment the line below; the last assignment wins and the OIDC variables
# are then ignored.
# VB_OFFICE32_AUTH=guest

# A real provider such as Google: register
# http://localhost:5173/auth/callback as a redirect URI there and replace
# the issuer, client ID and secret above, e.g.
# VB_OFFICE32_OIDC_ISSUER=https://accounts.google.com
